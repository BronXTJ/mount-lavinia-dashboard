# Copy to .env.local for Vite. Never commit real keys.

# Optional. CARTO basemap key (baked in at build time for dark basemaps).
# Sources: this file, or gitignored "carto dark access.txt" (plain key or tile URL with ?key=),
# or GitHub Actions secret VITE_CARTO_API_KEY for CI deploy.
# Restrict the key in the CARTO dashboard to bronxtj.github.io and localhost.
VITE_CARTO_API_KEY=

# Optional. Pre-fills the What-if worker pairing token in the browser.
# The worker still prints a token at startup; /health stays open without it.
VITE_WHAT_IF_WORKER_TOKEN=
